# SQLite file. Deleted and re-seeded with `python -m mock_bank.seed`.
MOCK_BANK_DB=mock_bank.db

# Where the AccessAI service publishes its token signing keys.
ACCESSAI_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Accept the SDK's offline "dev-unsigned." tokens. Local development only; never in a deployed demo.
ALLOW_DEV_TOKENS=false

# Fault injection for demos: none | decline | timeout | error. Can also be changed at runtime via POST /v1/_faults.
FAULT_MODE=none
FAULT_TIMEOUT_SECONDS=30
